#!/bin/bash
# omarchy:summary=One-shot Hermes install + set as default agent
# omarchy:examples=omarchy-setup-hermes

set -e

# Installs Hermes if missing, then writes ~/.config/omarchy/defaults/agent
# so it becomes the active default. Mirrors omarchy-default-agent's
# shape but handles the install side too (since the base omarchy-default-agent
# script doesn't know about Hermes yet).
#
# Idempotent — safe to re-run. If Hermes is already installed, just
# sets the default and exits.

if ! command -v hermes >/dev/null 2>&1; then
    echo "Hermes not found. Installing..."
    if ! curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash; then
        echo "Hermes installer failed. Install manually: curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash"
        echo "Then re-run this script."
        exit 1
    fi
fi

mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/defaults"
echo "hermes" > "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/defaults/agent"
echo "Hermes is set as your default agent."
