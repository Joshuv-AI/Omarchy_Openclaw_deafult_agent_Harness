#!/usr/bin/env python3
"""Collect MiniMax token-usage data for the Omarchy agents panel.

Queries MiniMax's `/v1/token_plan/remains` endpoint, which returns the
account's remaining credits and the reset windows for the 5h interval
and the weekly cycle. Same shape as the OpenClaw collector used to
write before token-usage was split out into this dedicated provider.

Reads:
  - ~/.openclaw/.env (for MINIMAX_API_KEY — shared with OpenClaw onboard)

Writes:
  - ~/.local/state/omarchy/agents/usage/minimax.json
    One JSON record the panel reads as provider data.

Output schema matches the panel's `providerColorFor` + MiniMax display
block (which uses mmIntervalFraction / mmIntervalPct / mmIntervalReset
helpers already in Panel.qml).
"""
# omarchy:summary=Print MiniMax token usage as JSON
# omarchy:args=[--force]
# omarchy:hidden=true

from __future__ import annotations

import json
import os
import re
import sys
import urllib.error
import urllib.request
from pathlib import Path

AGENT_ID = "minimax"
AGENT_NAME = "MiniMax"
USAGE_DIR = Path(
    os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")
) / "omarchy" / "agents" / "usage"
USAGE_FILE = USAGE_DIR / f"{AGENT_ID}.json"
ENV_FILE = Path.home() / ".openclaw" / ".env"
API_BASE = "https://www.minimax.io/v1"
API_BASE_CN = "https://api.minimaxi.com/v1"
API_TIMEOUT_SECONDS = 8

# Env var names that the MiniMax collector will accept, in priority
# order. The first one found wins. Covers:
#   MINIMAX_API_KEY        — International Coding Plan / Standard API key
#   MINIMAX_PORTAL_TOKEN   — Qwen Portal / OAuth-portal-derived token
#   MINIMAX_PORTAL_API_KEY — alternate name some setups use
API_KEY_VARS = ("MINIMAX_API_KEY", "MINIMAX_PORTAL_TOKEN", "MINIMAX_PORTAL_API_KEY")


def read_api_key():
    """Read MiniMax API key from ~/.openclaw/.env.

    Tries multiple env var names (API_KEY_VARS) to cover both the
    international Coding Plan / Standard API key path AND the
    OAuth-portal-derived token path. The first match wins.

    Also auto-detects from process env (so collectors launched from
    a shell that has the key set inherit it) and from shell rc files.
    Returns '' if nothing found.
    """
    candidates = []
    for var in API_KEY_VARS:
        v = os.environ.get(var)
        if v:
            candidates.append((var, v))
    if ENV_FILE.exists():
        try:
            text = ENV_FILE.read_text(errors="replace")
        except Exception:
            text = ""
        for var in API_KEY_VARS:
            pattern = re.compile(
                rf"^\s*(?:export\s+)?{re.escape(var)}\s*=\s*(\S+)\s*$",
                re.MULTILINE,
            )
            m = pattern.search(text)
            if m:
                candidates.append((var, m.group(1).strip().strip('"').strip("'")))

    # First valid candidate wins
    for _var, value in candidates:
        if value:
            return value
    return ""


def fetch_token_plan(api_key):
    """GET /v1/token_plan/remains with Bearer auth. Returns parsed JSON or raises.

    Tries the international endpoint first. If the international key is
    rejected (401/403), retries against the China-mainland endpoint
    (api.minimaxi.com). This covers users whose API key is region-bound
    without requiring them to set MINIMAX_BASE_URL manually.
    """
    bases = (API_BASE, API_BASE_CN)
    last_err = None
    for base in bases:
        req = urllib.request.Request(
            f"{base}/token_plan/remains",
            headers={"Authorization": f"Bearer {api_key}"},
        )
        try:
            with urllib.request.urlopen(req, timeout=API_TIMEOUT_SECONDS) as resp:
                body = resp.read().decode("utf-8", errors="replace")
                return json.loads(body) if body else {}
        except urllib.error.HTTPError as e:
            last_err = e
            # 401/403: key doesn't work on this base, try next base.
            # Other codes (429, 5xx): propagate — the key is fine, the
            # API is the problem; fallback wouldn't help.
            if e.code not in (401, 403):
                raise
            continue
        except Exception:
            # Network error / timeout / DNS — try the next base once.
            last_err = None
            continue
    # All bases exhausted
    if last_err is not None:
        raise last_err
    raise urllib.error.URLError("All MiniMax endpoints unreachable")


def _humanize_seconds(value):
    """Convert a duration to a compact 'Xh Ym' / 'Xd Yh' string.

    MiniMax's API returns `remains_time` and `weekly_remains_time` in
    MILLISECONDS despite the field names not having a `_ms` suffix
    (values around 1.7e7 for a 5h window, 5.2e8 for a weekly window).
    Auto-detect: anything larger than 7 days in seconds (604800) is
    almost certainly ms, not s — 7 days in ms would mean 7 days in 7
    days, which is nonsense for a "remaining" duration.
    """
    try:
        s = int(value)
    except Exception:
        return ""
    if s <= 0:
        return ""
    if s > 604800:  # bigger than 7 days in seconds → treat as ms
        s = s // 1000
    if s <= 0:
        return ""
    days, rem = divmod(s, 86400)
    hours, rem = divmod(rem, 3600)
    minutes = rem // 60
    if days > 0:
        return f"{days}d {hours}h"
    if hours > 0:
        return f"{hours}h {minutes}m"
    if minutes > 0:
        return f"{minutes}m"
    return f"{s}s"


def normalize_plan(raw):
    """Parse MiniMax /v1/token_plan/remains into Panel.qml's expected shape.

    Real API response:
      {"model_remains": [{"model_name": "general"|"video",
                         "current_interval_remaining_percent": 96,
                         "current_weekly_remaining_percent": 100,
                         "remains_time": 17576917,
                         "weekly_remains_time": 517976917, ...}],
       "base_resp": {"status_code": 0, ...}}

    Panel.qml expects:
      provider.minimaxTokenPlan.general.intervalRemainingPct  (0..100 number)
      provider.minimaxTokenPlan.general.weeklyRemainingPct   (0..100 number)
      provider.minimaxTokenPlan.general.intervalResetHuman   ("3h 15m")
      provider.minimaxTokenPlan.general.weeklyResetHuman     ("5d 12h")
      provider.minimaxTokenPlan.video.*                      (same shape)
    """
    out = {"general": None, "video": None}
    if not isinstance(raw, dict):
        return out
    items = raw.get("model_remains")
    if not isinstance(items, list):
        return out
    for entry in items:
        if not isinstance(entry, dict):
            continue
        name = str(entry.get("model_name") or "").strip()
        if name not in ("general", "video"):
            continue
        interval_pct = entry.get("current_interval_remaining_percent")
        weekly_pct = entry.get("current_weekly_remaining_percent")
        try:
            interval_pct = float(interval_pct) if interval_pct is not None else None
        except Exception:
            interval_pct = None
        try:
            weekly_pct = float(weekly_pct) if weekly_pct is not None else None
        except Exception:
            weekly_pct = None
        out[name] = {
            "intervalRemainingPct": interval_pct,
            "weeklyRemainingPct": weekly_pct,
            "intervalResetHuman": _humanize_seconds(entry.get("remains_time")),
            "weeklyResetHuman": _humanize_seconds(entry.get("weekly_remains_time")),
            "intervalStatus": entry.get("current_interval_status"),
            "weeklyStatus": entry.get("current_weekly_status"),
        }
    return out


def main():
    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    record = {
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "schemaVersion": 1,
        "provider": "minimax",
        "ready": False,
        "installed": True,
        "version": "",
        "activeModel": "",
        "minimaxAvailable": False,
        "minimaxError": "",
        "minimaxTokenPlan": {"general": None, "video": None},
        "minimaxSummary5h": "",
        "minimaxSummaryWeekly": "",
        "minimaxSummaryReset": "",
        "minimaxFetchedAt": "",
        "authHelpText": "",
    }

    api_key = read_api_key()
    if not api_key:
        record["authHelpText"] = (
            "Set MINIMAX_API_KEY in ~/.openclaw/.env to enable MiniMax token-usage data. "
            "Usually configured by running `openclaw onboard` once."
        )
        USAGE_FILE.write_text(json.dumps(record, indent=2))
        return

    try:
        raw = fetch_token_plan(api_key)
    except urllib.error.HTTPError as e:
        record["authHelpText"] = f"MiniMax API error: HTTP {e.code}"
        USAGE_FILE.write_text(json.dumps(record, indent=2))
        return
    except Exception as e:
        record["authHelpText"] = f"MiniMax API error: {e}"
        USAGE_FILE.write_text(json.dumps(record, indent=2))
        return

    plan = normalize_plan(raw)
    record["minimaxAvailable"] = bool(plan["general"] or plan["video"])

    # The OpenClaw collector's old output had a `summary5h` /
    # `summaryWeekly` / `summaryReset` shorthand. Recreate them here
    # from the plan so Panel.qml's display helpers can use them
    # unchanged. Fall back to empty string if the plan is missing.
    general = plan["general"] or {}
    video = plan["video"] or {}
    record["minimaxTokenPlan"] = plan
    def _pct_str(v):
        try:
            return f"{int(round(float(v)))}%" if v is not None else ""
        except Exception:
            return ""
    record["minimaxSummary5h"] = _pct_str(general.get("intervalRemainingPct"))
    record["minimaxSummaryWeekly"] = _pct_str(general.get("weeklyRemainingPct"))
    record["minimaxSummaryReset"] = (
        f"5h: {general.get('intervalResetHuman') or '—'} · "
        f"wk: {general.get('weeklyResetHuman') or '—'}"
    )
    record["minimaxFetchedAt"] = __import__("datetime").datetime.now(__import__("datetime").timezone.utc).isoformat()

    # If either window is "unlimited" (weekly pct == 100 with no cap),
    # the panel renders it as "∞ Unlimited" via mmWeeklyIsUnlimited.
    # No special-case here — the helper just checks pct >= 100.

    record["ready"] = record["minimaxAvailable"]
    USAGE_FILE.write_text(json.dumps(record, indent=2))


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(f"omarchy-agent-usage-minimax: {e!r}", file=sys.stderr)
        sys.exit(0)
