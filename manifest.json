{
  "name": "openclaw-integration",
  "displayName": "OpenClaw + Hermes + MiniMax + Kimi + Qwen for omArchy",
  "version": "2.4.0",
  "description": "Installs OpenClaw and Hermes plus optional collectors (Grok, Gemini) and integrates them into Omarchy's agents panel as a multi-provider dock with brand-colored progress rings. Adds an OpenClaw tab showing gateway state, version, active model, runtime, Discord status, total sessions. Adds a Hermes tab with a mirrored display (gateway/runtime/model/etc.) minus token-usage. Adds a MiniMax tab for token-usage data (5h + weekly bars) — split out of the OpenClaw record so the model data lives with the model, not the agent. Adds a Kimi sub-provider tab (auto-detects MOONSHOT_API_KEY from 5 locations; appears in dock only when OpenClaw/Hermes uses kimi/* model; click-to-setup dialog if no key found). Adds a Qwen sub-provider tab (auto-detects DASHSCOPE_API_KEY + QWEN_BASE_URL from 5 locations; appears in dock only when OpenClaw/Hermes uses qwen/* or dashscope/* model; purple ring; display-only — no setup UI). Registers lobster OpenClaw + wing Hermes entries in the super-space agents submenu. Optionally sets OpenClaw as the default agent.",
  "author": {
    "name": "OpenClaw for Omarchy contributors"
  },
  "license": "AGPL-3.0",
  "homepage": "https://openclaw.io",
  "minOmarchyVersion": "2026.08",
  "entryPoints": {
    "agentCollectors": [
      {
        "path": "bin/omarchy-agent-usage-openclaw",
        "installPath": "/usr/bin/omarchy-agent-usage-openclaw",
        "agentId": "openclaw",
        "agentName": "OpenClaw",
        "interface": "omarchy-agent-usage",
        "activeByDefault": true,
        "activation": "openclaw onboard (interactive)",
        "outputSchema": {
          "id": "string",
          "name": "string",
          "version": "string",
          "gatewayState": "active|stopped|not-installed|unknown",
          "activeModel": "string",
          "currentSessionId": "string",
          "currentSessionTitle": "string",
          "currentSessionUpdatedAt": "number",
          "gatewayStartedAt": "string",
          "nodeVersion": "string",
          "openclawPid": "string",
          "openclawUptime": "string",
          "discordStatus": "active|not-running|unknown",
          "ready": "boolean",
          "hasLocalStats": "boolean",
          "hasPromptStats": "boolean",
          "todayPrompts": "number",
          "todaySessions": "number",
          "todayTotalTokens": "number",
          "todayTokensByModel": "object",
          "recentDays": "array",
          "totalPrompts": "number",
          "totalSessions": "number",
          "activeDays": "number",
          "activeDates": "array",
          "modelUsage": "object",
          "cacheRatio": "number",
          "avgContext": "number",
          "limits": "array",
          "balance": "object|null",
          "provider": "string",
          "modelId": "string",
          "modelApi": "string",
          "usageStatusText": "string",
          "authHelpText": "string",
          "minimaxAvailable": "boolean",
          "minimaxError": "string",
          "minimaxTokenPlan": "object|null",
          "minimaxSummary5h": "string",
          "minimaxSummaryWeekly": "string",
          "minimaxSummaryReset": "string",
          "minimaxFetchedAt": "string"
        },
        "cacheFile": "~/.local/state/omarchy/agents/usage/openclaw.json",
        "stateFile": "~/.local/state/omarchy/agents/usage/openclaw.state.json",
        "refreshSeconds": 60
      },
      {
        "path": "bin/omarchy-agent-usage-grok",
        "installPath": "/usr/bin/omarchy-agent-usage-grok",
        "agentId": "grok",
        "agentName": "Grok",
        "interface": "omarchy-agent-usage",
        "activeByDefault": false,
        "activation": "XAI_API_KEY env var (https://console.x.ai)",
        "outputSchema": {
          "id": "string",
          "name": "string",
          "schemaVersion": "number",
          "provider": "string",
          "ready": "boolean",
          "installed": "boolean",
          "version": "string",
          "activeModel": "string",
          "limits": "array",
          "recentDays": "array",
          "modelUsage": "object",
          "todayPrompts": "number",
          "todaySessions": "number",
          "todayTotalTokens": "number",
          "totalPrompts": "number",
          "totalSessions": "number",
          "activeDays": "number",
          "activeDates": "array",
          "avgContext": "number",
          "cacheRatio": "number",
          "balance": "object|null",
          "authHelpText": "string"
        },
        "cacheFile": "~/.local/state/omarchy/agents/usage/grok.json",
        "remoteEndpoint": "GET https://api.x.ai/v1/api-key",
        "refreshSeconds": 60,
        "networkCalls": "only when XAI_API_KEY is set"
      },
      {
        "path": "bin/omarchy-agent-usage-gemini",
        "installPath": "/usr/bin/omarchy-agent-usage-gemini",
        "agentId": "gemini",
        "agentName": "Gemini",
        "interface": "omarchy-agent-usage",
        "activeByDefault": false,
        "activation": "GEMINI_API_KEY or GOOGLE_API_KEY env var (https://aistudio.google.com/apikey)",
        "outputSchema": {
          "id": "string",
          "name": "string",
          "schemaVersion": "number",
          "provider": "string",
          "ready": "boolean",
          "installed": "boolean",
          "version": "string",
          "activeModel": "string",
          "limits": "array",
          "recentDays": "array",
          "modelUsage": "object",
          "todayPrompts": "number",
          "todaySessions": "number",
          "todayTotalTokens": "number",
          "totalPrompts": "number",
          "totalSessions": "number",
          "activeDays": "number",
          "activeDates": "array",
          "avgContext": "number",
          "cacheRatio": "number",
          "balance": "object|null",
          "authHelpText": "string"
        },
        "cacheFile": "~/.local/state/omarchy/agents/usage/gemini.json",
        "remoteEndpoint": "GET https://generativelanguage.googleapis.com/v1beta/models",
        "refreshSeconds": 60,
        "networkCalls": "only when GEMINI_API_KEY or GOOGLE_API_KEY is set"
      },
      {
        "path": "bin/omarchy-agent-usage-hermes",
        "installPath": "/usr/bin/omarchy-agent-usage-hermes",
        "agentId": "hermes",
        "agentName": "Hermes",
        "interface": "omarchy-agent-usage",
        "activeByDefault": false,
        "activation": "curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash, then hermes setup --portal",
        "outputSchema": {
          "id": "string",
          "name": "string",
          "schemaVersion": "number",
          "provider": "string",
          "ready": "boolean",
          "installed": "boolean",
          "version": "string",
          "activeModel": "string",
          "gatewayState": "active|stopped|unknown",
          "currentSessionId": "string",
          "currentSessionUpdatedAt": "number",
          "gatewayStartedAt": "string",
          "nodeVersion": "string",
          "hermesPid": "string",
          "hermesUptime": "string",
          "discordStatus": "string",
          "todayPrompts": "number",
          "todaySessions": "number",
          "todayTotalTokens": "number",
          "totalPrompts": "number",
          "totalSessions": "number",
          "activeDays": "number",
          "activeDates": "array",
          "modelUsage": "object",
          "avgContext": "number",
          "cacheRatio": "number",
          "balance": "object|null",
          "authHelpText": "string",
          "recentDays": "array",
          "limits": "array",
          "_notes": "recentDays / limits / modelUsage are written as empty arrays — Hermes has no token usage to display. The dock ring uses gatewayState (full when active, empty when stopped) instead of a usage fraction."
        },
        "cacheFile": "~/.local/state/omarchy/agents/usage/hermes.json",
        "refreshSeconds": 60,
        "networkCalls": "none from the collector (only local subprocess checks)"
      },
      {
        "path": "bin/omarchy-agent-usage-minimax",
        "installPath": "/usr/bin/omarchy-agent-usage-minimax",
        "agentId": "minimax",
        "agentName": "MiniMax",
        "interface": "omarchy-agent-usage",
        "activeByDefault": false,
        "activation": "MINIMAX_API_KEY in ~/.openclaw/.env (typically configured by running `openclaw onboard` once)",
        "outputSchema": {
          "id": "string",
          "name": "string",
          "schemaVersion": "number",
          "provider": "string",
          "ready": "boolean",
          "installed": "boolean",
          "version": "string",
          "activeModel": "string",
          "minimaxAvailable": "boolean",
          "minimaxError": "string",
          "minimaxTokenPlan": "object",
          "minimaxSummary5h": "string",
          "minimaxSummaryWeekly": "string",
          "minimaxSummaryReset": "string",
          "minimaxFetchedAt": "string",
          "authHelpText": "string"
        },
        "cacheFile": "~/.local/state/omarchy/agents/usage/minimax.json",
        "refreshSeconds": 60,
        "networkCalls": "GET https://www.minimax.io/v1/token_plan/remains (only when MINIMAX_API_KEY is set)"
      },
      {
        "path": "bin/omarchy-agent-usage-kimi",
        "installPath": "/usr/bin/omarchy-agent-usage-kimi",
        "agentId": "kimi",
        "agentName": "Kimi (Moonshot AI)",
        "interface": "omarchy-agent-usage",
        "category": "model-provider",
        "activeByDefault": false,
        "activation": "MOONSHOT_API_KEY in ~/.openclaw/.env (auto-set by openclaw onboard) OR user can set it via the KimiSetupDialog in the dock panel",
        "outputSchema": {
          "id": "string",
          "name": "string",
          "schemaVersion": "number",
          "provider": "string",
          "ready": "boolean",
          "installed": "boolean",
          "version": "string",
          "activeModel": "string",
          "kimiAvailable": "boolean",
          "kimiUsageMode": "string (none | token-usage | connection)",
          "kimiRingEmpty": "boolean",
          "kimiAccountInfo": "object (only set when usageMode=token-usage)",
          "kimiFetchedAt": "string",
          "authHelpText": "string"
        },
        "cacheFile": "~/.local/state/omarchy/agents/usage/kimi.json",
        "refreshSeconds": 60,
        "networkCalls": "GET https://api.moonshot.ai/v1/users/me (Bearer auth) — token-usage probe; GET https://api.moonshot.ai/v1/models — connection fallback when /users/me doesn't return numeric usage data"
      },
      {
        "path": "bin/omarchy-agent-usage-qwen",
        "installPath": "/usr/bin/omarchy-agent-usage-qwen",
        "agentId": "qwen",
        "agentName": "Qwen (DashScope)",
        "interface": "omarchy-agent-usage",
        "category": "model-provider",
        "activeByDefault": false,
        "activation": "DASHSCOPE_API_KEY auto-detected from up to 5 locations (process env, ~/.openclaw/.env, shell rc, /proc/<pid>/environ of running OpenClaw/Hermes, systemd EnvironmentFile). QWEN_BASE_URL optional, defaults to https://dashscope-intl.aliyuncs.com/compatible-mode/v1 (international). China-mainland users set QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1.",
        "outputSchema": {
          "id": "string",
          "name": "string",
          "schemaVersion": "number",
          "provider": "string",
          "ready": "boolean",
          "installed": "boolean",
          "version": "string",
          "fetchedAt": "string",
          "qwenAvailable": "boolean",
          "qwenUsageMode": "string (connection | none)",
          "qwenRingEmpty": "boolean",
          "qwenBaseUrl": "string",
          "qwenBaseUrlSource": "string (process-env | openclaw-env | shell-rc | proc-environ | systemd-envfile | default)",
          "qwenKeySource": "string (same enum, plus 'missing')",
          "qwenModelCount": "number | null",
          "qwenError": "string | null",
          "authHelpText": "string (always empty per display-only policy)"
        },
        "cacheFile": "~/.local/state/omarchy/agents/usage/qwen.json",
        "refreshSeconds": 60,
        "networkCalls": "GET ${QWEN_BASE_URL:-https://dashscope-intl.aliyuncs.com/compatible-mode/v1}/models (Bearer auth) — single authenticated connection probe. No numeric quota API exists on DashScope; only dynamic monthly tier-based TPM documented at console level."
      }
    ],
    "panelPatch": {
      "path": "targets/Panel.qml",
      "installPath": "/usr/share/omarchy/shell/plugins/agents/Panel.qml",
      "backupSuffix": ".openclaw-backup"
    },
    "mainPatch": {
      "path": "targets/Main.qml",
      "installPath": "/usr/share/omarchy/shell/plugins/agents/Main.qml",
      "backupSuffix": ".openclaw-backup"
    },
    "manifestPatch": {
      "path": "targets/manifest.json",
      "installPath": "/usr/share/omarchy/shell/plugins/agents/manifest.json",
      "backupSuffix": ".openclaw-backup",
      "purpose": "Enables all 6 providers in defaults.providers and sets refreshIntervalSec to 60"
    },
    "assets": [
      {
        "path": "assets/claude.svg",
        "installPath": "/usr/share/omarchy/shell/plugins/agents/assets/claude.svg",
        "purpose": "Anthropic brand mark (greied)"
      },
      {
        "path": "assets/codex.svg",
        "installPath": "/usr/share/omarchy/shell/plugins/agents/assets/codex.svg",
        "purpose": "OpenAI brand mark (greied)"
      },
      {
        "path": "assets/codex-light.svg",
        "installPath": "/usr/share/omarchy/shell/plugins/agents/assets/codex-light.svg",
        "purpose": "Light-theme OpenAI variant (greied)"
      },
      {
        "path": "assets/fireworks.svg",
        "installPath": "/usr/share/omarchy/shell/plugins/agents/assets/fireworks.svg",
        "purpose": "Fireworks brand mark (greied)"
      },
      {
        "path": "assets/grok.svg",
        "installPath": "/usr/share/omarchy/shell/plugins/agents/assets/grok.svg",
        "purpose": "xAI Grok stylized X (greied)"
      },
      {
        "path": "assets/gemini.svg",
        "installPath": "/usr/share/omarchy/shell/plugins/agents/assets/gemini.svg",
        "purpose": "Google Gemini interlocking diamond (greied)"
      },
      {
        "path": "assets/hermes.svg",
        "installPath": "/usr/share/omarchy/shell/plugins/agents/assets/hermes.svg",
        "purpose": "Hermes messenger wing (greied)"
      },
      {
        "path": "assets/minimax.svg",
        "installPath": "/usr/share/omarchy/shell/plugins/agents/assets/minimax.svg",
        "purpose": "MiniMax stylized M (greied)"
      },
      {
        "path": "assets/kimi.svg",
        "installPath": "/usr/share/omarchy/shell/plugins/agents/assets/kimi.svg",
        "purpose": "Kimi brand mark (greied, base64-embedded PNG)"
      },
      {
        "path": "assets/qwen.svg",
        "installPath": "/usr/share/omarchy/shell/plugins/agents/assets/qwen.svg",
        "purpose": "Qwen brand mark (pre-greyscaled, base64-embedded PNG inside SVG wrapper)"
      },
      {
        "path": "assets/openclaw.svg",
        "installPath": "/usr/share/omarchy/shell/plugins/agents/assets/openclaw.svg",
        "purpose": "Lobster emoji with grayscale filter"
      },
      {
        "path": "assets/openclaw-light.svg",
        "installPath": "/usr/share/omarchy/shell/plugins/agents/assets/openclaw-light.svg",
        "purpose": "Light-theme lobster variant"
      }
    ],
    "menuEntry": {
      "configPath": "~/.config/omarchy/extensions/omarchy-menu.jsonc",
      "provider": "super.submenus.agents.openclaw",
      "icon": "🦞",
      "label": "OpenClaw",
      "action": "omarchy-agent openclaw"
    },
    "defaultAgent": {
      "configPath": "~/.config/omarchy/defaults/agent",
      "value": "openclaw"
    }
  },
  "permissions": {
    "filesystem": {
      "writes": [
        "/usr/bin/omarchy-agent-usage-openclaw",
        "/usr/bin/omarchy-agent-usage-grok",
        "/usr/bin/omarchy-agent-usage-gemini",
        "/usr/share/omarchy/shell/plugins/agents/Panel.qml",
        "/usr/share/omarchy/shell/plugins/agents/Main.qml",
        "/usr/share/omarchy/shell/plugins/agents/manifest.json",
        "/usr/share/omarchy/shell/plugins/agents/assets/claude.svg",
        "/usr/share/omarchy/shell/plugins/agents/assets/codex.svg",
        "/usr/share/omarchy/shell/plugins/agents/assets/codex-light.svg",
        "/usr/share/omarchy/shell/plugins/agents/assets/fireworks.svg",
        "/usr/share/omarchy/shell/plugins/agents/assets/grok.svg",
        "/usr/share/omarchy/shell/plugins/agents/assets/gemini.svg",
        "/usr/share/omarchy/shell/plugins/agents/assets/openclaw.svg",
        "/usr/share/omarchy/shell/plugins/agents/assets/openclaw-light.svg",
        "~/.config/omarchy/extensions/omarchy-menu.jsonc",
        "~/.config/omarchy/defaults/agent",
        "~/.local/state/omarchy/agents/usage/openclaw.json",
        "~/.local/state/omarchy/agents/usage/openclaw.state.json",
        "~/.local/state/omarchy/agents/usage/grok.json",
        "~/.local/state/omarchy/agents/usage/gemini.json",
        "/usr/bin/omarchy-agent-usage-hermes",
        "/usr/share/omarchy/shell/plugins/agents/assets/hermes.svg",
        "~/.local/state/omarchy/agents/usage/hermes.json",
        "/usr/bin/omarchy-agent-usage-minimax",
        "/usr/share/omarchy/shell/plugins/agents/assets/minimax.svg",
        "~/.local/state/omarchy/agents/usage/minimax.json",
        "/usr/bin/omarchy-agent-usage-kimi",
        "",
        "/usr/share/omarchy/shell/plugins/agents/assets/kimi.svg",
        "~/.local/state/omarchy/agents/usage/kimi.json",
        "/usr/bin/omarchy-agent-usage-qwen",
        "/usr/share/omarchy/shell/plugins/agents/assets/qwen.svg",
        "~/.local/state/omarchy/agents/usage/qwen.json"
      ],
      "sudo": "yes (for /usr/bin/ and /usr/share/omarchy/ paths only)",
      "notes": "No writes outside the paths listed. uninstall.sh restores system files from .openclaw-backup created at install time."
    },
    "subprocess": {
      "executes": [
        "openclaw --version",
        "openclaw onboard (interactive, optional)",
        "systemctl --user is-active openclaw-gateway.service",
        "systemctl --user show openclaw-gateway.service",
        "node --version",
        "pgrep -f openclaw",
        "pgrep -f discord",
        "command -v hermes",
        "hermes --version",
        "hermes status",
        "pgrep -f hermes",
        "ps -o etime= -p <pid>",
        "curl -fsSL https://hermes-agent.nousresearch.com/install.sh",
        "hermes setup --portal (interactive)",
        "command -v openclaw (for env lookup, not for detection)",
        " <MOONSHOT_API_KEY> (called from Panel.qml's KimiSetupDialog)"
      ],
      "remoteCode": "no",
      "polkit": "no",
      "notes": "OpenClaw collector reads user-local state only. Grok and Gemini collectors make outbound HTTP GET requests to provider APIs ONLY when their respective API key env vars are set. No calls from install/uninstall scripts."
    },
    "apiKeys": {
      "stored": [
        {
          "provider": "openclaw",
          "location": "~/.openclaw/.env (chmod 600), managed by `openclaw onboard`"
        },
        {
          "provider": "grok",
          "location": "XAI_API_KEY env var (read by collector only, never persisted)"
        },
        {
          "provider": "gemini",
          "location": "GEMINI_API_KEY or GOOGLE_API_KEY env var (read by collector only, never persisted)"
        }
      ],
      "inPackage": "none",
      "notes": "This package never ships or stores API keys. OpenClaw uses its own onboarding flow; Grok and Gemini keys come from the user's environment."
    }
  },
  "securityBoundaries": {
    "neverModifies": [
      "/etc/passwd",
      "/etc/shadow",
      "/etc/sudoers",
      "Polkit policies",
      "systemd user services (only reads, never creates)",
      "files outside the install paths listed in permissions.filesystem"
    ],
    "neverExecutes": [
      "anything with sudo privileges beyond the file copies listed above",
      "remote code or remote command execution",
      "credential display (the panel deliberately hides auth text)",
      "background jobs that survive panel close"
    ],
    "explicitNonGoals": [
      "Outbound calls from install/uninstall scripts (only collectors make network calls)",
      "Background services or daemons (the sweeper invokes us; we don't poll on our own)",
      "Privileged operations (no sudo tricks, no capability escalation)",
      "Storing or transmitting API keys (delegated to OpenClaw or user env)",
      "Replacing Omarchy's stock Panel.qml / Main.qml wholesale (we add OpenClaw block + dock, keep all upstream sections intact)"
    ]
  },
  "install": {
    "command": "./install.sh",
    "preflight": [
      "Omarchy installed (any recent version with Hyprland + Quickshell)",
      "OpenClaw binary (auto-fetched from https://openclaw.io/install.sh if missing)",
      "sudo access for /usr/bin/ and /usr/share/omarchy/"
    ],
    "postInstall": [
      "Three collectors at /usr/bin/omarchy-agent-usage-{openclaw,grok,gemini}",
      "Eight SVG assets in Omarchy's agents panel assets dir",
      "Panel.qml + Main.qml + manifest.json patched (originals backed up as *.openclaw-backup)",
      "OpenClaw entry in omarchy-menu.jsonc under super → agents",
      "Optional: default agent set to openclaw",
      "Quickshell reloaded"
    ],
    "panelChanges": [
      "Dock shows one circle per connected provider (claude, codex, fireworks from Omarchy base; openclaw from this package; grok and gemini appear when keys are set)",
      "Each dock circle has a brand-colored progress ring around a greied center icon",
      "Double-click anywhere on the dock toggles ring colors on/off",
      "Click a circle to open the panel focused on that provider",
      "Manifest defaults enable all 6 providers; refresh interval is 60s",
      "Hermes appears as an 11th provider in the agents default select screen and the dock",
      "Hermes dock ring is a connection ring (full when gateway active, empty when stopped) — not a usage ring",
      "Hermes panel popup mirrors OpenClaw minus the token-usage sections (no recentDays / limits / models chart)",
      "MiniMax appears as its own provider in the dock with a red ring (color #FF0000)",
      "MiniMax panel popup shows token-usage (5h + weekly bars + reset countdowns) — split from OpenClaw",
      "OpenClaw panel popup no longer shows token-usage (data now lives in MiniMax record)"
    ]
  },
  "uninstall": {
    "command": "./uninstall.sh",
    "reversible": "yes — restores Panel.qml + Main.qml + manifest.json from .openclaw-backup",
    "sideEffects": "Removes collectors, this package's SVGs, menu entry. Does NOT uninstall OpenClaw itself. Does NOT remove XAI_API_KEY or GEMINI_API_KEY env vars (unset those yourself if you want)."
  },
  "docs": {
    "readme": "README.md",
    "architecture": "docs/architecture.md",
    "security": "docs/security.md",
    "telemetry": "docs/telemetry.md",
    "panel": "docs/panel.md",
    "troubleshooting": "docs/troubleshooting.md",
    "aiAgentSkill": "skill/SKILL.md"
  }
}
